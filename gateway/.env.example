# Local NanoMQ broker
NANOMQ_HOST=127.0.0.1
NANOMQ_PORT=1883
NANOMQ_USERNAME=
NANOMQ_PASSWORD=
NANOMQ_ALLOW_ANONYMOUS=true

# ThingsBoard (CoreIOT) Gateway connection
TB_MQTT_HOST=fuvi-server.tailc75d93.ts.net
TB_MQTT_PORT=1883
TB_GATEWAY_DEVICE_NAME=PC Gateway
# Set the access token from the Gateway device created in ThingsBoard UI
TB_GATEWAY_TOKEN=CHANGE_ME_TO_GATEWAY_ACCESS_TOKEN

# Downstream devices configuration
TB_DEVICE_ESP1=ESP1
TB_PROFILE_ESP1=CO2 Sensor
TB_DEVICE_ESP2=ESP2
TB_PROFILE_ESP2=TDS Sensor

# Persistence and dashboard bind
DATABASE_URL=sqlite://gateway.db
HTTP_BIND=127.0.0.1:8080

