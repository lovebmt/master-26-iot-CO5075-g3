# Local NanoMQ broker
NANOMQ_HOST=127.0.0.1
NANOMQ_PORT=1883
NANOMQ_USERNAME=
NANOMQ_PASSWORD=
NANOMQ_ALLOW_ANONYMOUS=true

# ThingsBoard (CoreIOT) Gateway connection
TB_MQTT_HOST=fuvi-server.tailc75d93.ts.net
TB_MQTT_PORT=10000
TB_GATEWAY_DEVICE_NAME=PC Gateway
# Gateway device access token from CoreIOT
TB_GATEWAY_TOKEN=dd77ZqjaYCpv2F2sG71E

# Downstream devices configuration
TB_DEVICE_ESP1=ESP1
TB_PROFILE_ESP1=esp_temp_humi
TB_DEVICE_ESP2=ESP2
TB_PROFILE_ESP2=esp_hub
TB_DEVICE_ESP3=ESP3
TB_PROFILE_ESP3=esp_ble

# Persistence and dashboard bind
DATABASE_URL=sqlite://gateway.db
HTTP_BIND=127.0.0.1:8080

